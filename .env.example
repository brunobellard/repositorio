# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Dashboard > Connect, ou Settings > API Keys). Use a "publishable key", nunca a "secret key".
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Endereço do site publicado (versão web), usado no link público de agendamento.
# Ex: https://projeto-app-beleza.expo.app  -> link fica https://projeto-app-beleza.expo.app/agendar/seu-estudio
EXPO_PUBLIC_BOOKING_URL=

# Endereço do site publicado: Termos, Privacidade e página de nova senha.
# Se ficar vazio, usa o mesmo endereço de EXPO_PUBLIC_BOOKING_URL.
EXPO_PUBLIC_WEB_URL=

# Telemetria (opcional; sem estas variáveis o app funciona igual, só sem telemetria).
# Só variáveis com prefixo EXPO_PUBLIC_ chegam ao app. São chaves públicas de envio (não são segredos),
# mas mesmo assim ficam no .env.local e nas variáveis do EAS, não no código.
# Sentry (erros e desempenho): Settings > Projects > <projeto> > Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=
# PostHog (analytics de produto, só com login): Project settings > Project API key (começa com phc_)
EXPO_PUBLIC_POSTHOG_KEY=
# Região do PostHog: https://us.i.posthog.com (padrão) ou https://eu.i.posthog.com
EXPO_PUBLIC_POSTHOG_HOST=
# Upload de source maps do Sentry nas builds (EAS: variável "sensitive"). Este, sim, é segredo:
# nunca com prefixo EXPO_PUBLIC_ e nunca no repositório.
# SENTRY_AUTH_TOKEN=
