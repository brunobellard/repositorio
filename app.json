{
  "expo": {
    "name": "Esmero",
    "slug": "projeto_app_beleza",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "projetoappbeleza",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.brunobellard.projetoappbeleza"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7EBED",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.brunobellard.projeto_app_beleza"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8F6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Permita que o Esmero use o Face ID para desbloquear o app."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita que o Esmero acesse suas fotos para escolher o logo do estúdio.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permita que o Esmero use o Face ID para desbloquear o app."
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#B76E79",
          "defaultChannel": "agendamentos"
        }
      ],
      [
        "@sentry/react-native",
        {
          "url": "https://sentry.io/",
          "organization": "bruno-mw",
          "project": "repositorio"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5ce11fbb-b674-4ad1-8484-5a89b9af2b7e"
      }
    },
    "owner": "brunobellard"
  }
}
